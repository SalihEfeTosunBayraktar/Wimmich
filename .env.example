# Wimmich configuration reference
#
# Copy to ".env" in this folder and uncomment only what you want to change.
# Every setting shown is optional - the value after "=" is the built-in
# default, so an empty .env behaves exactly like no .env at all.
#
# Most people never need this file: the installer, start.bat and the admin
# panel between them cover the settings that matter day to day. It exists
# because config.py reads 40-odd environment variables and there was
# previously no single place to see what they were.
#
# Anything the admin panel can also change (storage limit, tunnel token,
# LAN access, job concurrency, GPU idle-unload, performance profile) is
# written to its own file at runtime and will override what you put here.


# ─── Server ──────────────────────────────────────────────────────────────
# 0.0.0.0 listens on every interface, which is what makes the app reachable
# from other devices on your network. 127.0.0.1 restricts it to this machine.
#WIMMICH_HOST=0.0.0.0
#WIMMICH_PORT=3000


# ─── Storage ─────────────────────────────────────────────────────────────
# Where photos, videos, thumbnails and ML data live. Defaults to ./data.
# Point this at a big drive if the system disk is small. NOTE: the database
# itself stays in the repo's own data/ folder regardless - to move that too,
# set WIMMICH_DB_URL as well.
#WIMMICH_DATA_DIR=D:\WimmichLibrary

#WIMMICH_DB_URL=sqlite+aiosqlite:///D:/WimmichLibrary/wimmich.db

# 0 = no limit. Used for the storage warning badges, not a hard cap.
#WIMMICH_TOTAL_STORAGE_LIMIT_MB=0
#WIMMICH_STORAGE_WARN_PERCENT=90
#WIMMICH_DISK_WARN_FREE_GB=10

# Per-file upload ceiling, in megabytes.
#WIMMICH_MAX_UPLOAD_MB=500

# How long deleted items stay in the trash. Each user can override this for
# themselves from the Trash page.
#WIMMICH_TRASH_DAYS=30

# Folders imported in "reference" mode - left where they are rather than
# copied into the library. Semicolon-separated.
#WIMMICH_EXTERNAL_LIBS=E:\Photos;F:\OldBackups


# ─── Security ────────────────────────────────────────────────────────────
# Leave this alone unless you know you need it. If unset, a strong secret is
# generated on first boot and written to .env automatically. Changing it
# signs everyone out immediately, including your own session.
#WIMMICH_JWT_SECRET=

# How long a login stays valid, in hours. 168 = 7 days.
#WIMMICH_JWT_EXPIRE_HOURS=168

# Brute-force protection: N failures within the window locks further
# attempts for that account.
#WIMMICH_LOGIN_MAX_FAILURES=10
#WIMMICH_LOGIN_FAILURE_WINDOW_SECONDS=900

# Serves requests arriving on a LAN address at all. Loopback always works,
# so this can never lock you out of your own machine. Also toggleable from
# the admin panel.
#WIMMICH_LAN_ACCESS_ENABLED=true


# ─── Remote access ───────────────────────────────────────────────────────
#WIMMICH_TUNNEL_TOKEN=
#WIMMICH_TUNNEL_CUSTOM_DOMAIN=
#WIMMICH_AUTO_START_TUNNEL=false
#WIMMICH_CLOUDFLARED_EXE_NAME=cloudflared.exe


# ─── External binaries ───────────────────────────────────────────────────
# Both are found automatically. Set these only to force a specific install.
#WIMMICH_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#WIMMICH_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe


# ─── Background jobs ─────────────────────────────────────────────────────
# How many files are processed at once. The admin panel suggests a value
# based on your CPU and RAM, and setting it there is easier than here.
#WIMMICH_JOB_IMPORT_CONCURRENCY=4
#WIMMICH_JOB_IMPORT_COMMIT_BATCH_SIZE=10
#WIMMICH_JOB_POLL_INTERVAL_SECONDS=2
#WIMMICH_JOB_BUSY_CHECK_INTERVAL_SECONDS=0.2

# Watchdog: a job that stops making progress for this long is retried.
#WIMMICH_JOB_HANG_TIMEOUT_MINUTES=90
#WIMMICH_JOB_HANG_MAX_RETRIES=2

# Keeps jobs from starving the web server. Low priority means the OS hands
# CPU straight back when a request arrives, while jobs still use idle cores.
# The Performance tab in the admin panel is the friendlier way to set these.
#WIMMICH_JOB_LOW_PRIORITY=true
#WIMMICH_JOB_MAX_CPU_THREADS=0

# Upper bound on processing a single file, so one corrupt photo can't stall
# an entire import.
#WIMMICH_MEDIA_PROCESSING_TIMEOUT_SECONDS=180

# Concurrent in-flight requests before lower-priority users start queueing.
#WIMMICH_REQUEST_PRIORITY_GATE_CAPACITY=8


# ─── Machine learning ────────────────────────────────────────────────────
# Master switch. Off means no semantic search and no face recognition;
# everything else works exactly as before.
#WIMMICH_ML_ENABLED=true
#WIMMICH_ML_BATCH_SIZE=16
#WIMMICH_ML_MODEL_LOAD_TIMEOUT_SECONDS=1200

# The CLIP model used for search. The default is multilingual, which is what
# makes non-English queries work; a smaller model is faster but English-only.
#WIMMICH_CLIP_MODEL=
#WIMMICH_CLIP_PRETRAINED=

# Frees GPU/system memory when the models have been idle this long.
#WIMMICH_GPU_IDLE_UNLOAD_ENABLED=false
#WIMMICH_GPU_IDLE_UNLOAD_MINUTES=15

# Face recognition tuning. Lower the threshold to group more aggressively
# (more false matches), raise it to be stricter (more duplicate people).
#WIMMICH_FACE_MATCH_THRESHOLD=0.7
#WIMMICH_FACE_MIN_CLUSTER_SIZE=2
#WIMMICH_FACE_DETECT_CONCURRENCY=6
#WIMMICH_FACE_DETECT_MAX_DIM=3000


# ─── Backup ──────────────────────────────────────────────────────────────
# How many database snapshots to keep alongside the media archive.
#WIMMICH_BACKUP_KEEP_DB_SNAPSHOTS=14
