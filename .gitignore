# Wimmich Git Ignore Rules

# Virtual Environment
venv/
.venv/

# Environment Variables & Tokens
.env
.env.local
.env.*.local

# Data Directory (Contains user photos, videos, database, ml data, and cloudflared binary)
# Anchored to the repo root (leading slash) - an unanchored "data/" matches
# ANY directory named "data" anywhere in the tree, which silently swallowed
# the whole android/.../com/wimmich/app/data/ Kotlin package (never made it
# into a commit, only caught when CI did a clean checkout and failed to
# compile - a real bug, not a hypothetical one).
/data/

# Scratch/Temporary script directories
scratch/

# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# OS/IDE metadata
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
