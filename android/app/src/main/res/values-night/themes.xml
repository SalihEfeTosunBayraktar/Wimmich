<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant - picked automatically by the platform when the
         system is in dark mode, no extra AppCompat/Material Components
         dependency needed. Dark background matches the web app's dark-mode
         bg color token in static/css/tokens.css. -->
    <style name="Theme.Wimmich" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:statusBarColor">#0A0A0F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
