<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted server: the user's Server URL is very often a plain-HTTP LAN
     address (e.g. http://192.168.1.50:3000), not a public HTTPS domain, so
     cleartext has to be allowed - same trade-off Immich's own app makes for
     the same reason. Remote access via Cloudflare Tunnel/Tailscale is HTTPS
     and unaffected either way. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
